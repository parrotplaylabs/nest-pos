# Server
PORT=3848
# DATA_DIR=./data

# Shop branding
SHOP_NAME=Nest POS
SHOP_TAGLINE=Inventory & point of sale

# Locale & currency
COUNTRY=US
LOCALE=en-US
CURRENCY_SYMBOL=$
CURRENCY_LOCALE=en-US
CURRENCY_CODE=USD

# Contact & defaults
CONTACT_NUMBER=(555) 123-4567
DEFAULT_LOW_STOCK=5
DEFAULT_PAYMENT_METHOD=other

# Payment UI
PAYMENT_REF_PLACEHOLDER=Transaction reference
ESTIMATE_PAYMENT_INFO=Mode of payment: cash, card, or bank transfer.

# Pick-up UI placeholders
PICKUP_HOURS_PLACEHOLDER=e.g. 9:00 AM - 5:00 PM
PICKUP_NOTES_PLACEHOLDER=Optional notes for customers

# JSON arrays (single line) — or use config/shop.json instead
# PAYMENT_METHODS=[{"value":"cash","label":"Cash"},{"value":"card","label":"Card"}]
# PICKUP_LOCATIONS=[{"id":"main-store","name":"Main store","address":"123 Example St"}]

# Optional config file overrides (copy config/shop.example.json → config/shop.json)
# SHOP_CONFIG_FILE=./config/shop.json

# Optional share template overrides
# SHARE_TEMPLATES_FILE=./config/share-templates.json

# HTTP Basic Auth (optional locally; required on Railway)
# HTTP_AUTH_USER=shop
# HTTP_AUTH_PASSWORD=change-me

# Backup download filename prefix
BACKUP_FILE_PREFIX=nest-pos-backup
